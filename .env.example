# Shared LLM Provider
# ───────────────────
# Set ONE provider key below. The course auto-detects which one to use.
# You can also force a provider with LLM_PROVIDER=openai|anthropic|deepseek|grok|qwen|ollama

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=sk-...

# Google Gemini (GOOGLE_API_KEY is also accepted)
GEMINI_API_KEY=...

# xAI Grok (OpenAI-compatible). The new provider layer (llm/) reads XAI_API_KEY and
# falls back to GROK_API_KEY; the older Appendix scripts (shared/provider.py) read
# only GROK_API_KEY, so set that one if you run them.
XAI_API_KEY=...

# Alibaba Qwen (OpenAI-compatible)
QWEN_API_KEY=...

# ── Model & Provider Override ─────────────────────────────────
# LLM_PROVIDER=openai        # force provider (auto-detected if omitted)
# LLM_MODEL=claude-sonnet-5  # override default model; current IDs live in llm/models.json
# OPENAI_BASE_URL=http://localhost:11434/v1  # for Ollama or local servers

# ── Module-specific (optional) ────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
CHROMA_HOST=localhost
CHROMA_PORT=8000
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
REDIS_URL=redis://localhost:6379
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
